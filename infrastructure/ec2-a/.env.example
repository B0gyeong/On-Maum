# Syntax-check examples only. Jenkins replaces these with pushed image digests.
API_GATEWAY_IMAGE=docker.io/leejeongmin24/on-maum:api-gateway-example
IOT_DEVICE_IMAGE=docker.io/leejeongmin24/on-maum:iot-device-service-example
MONITORING_IMAGE=docker.io/leejeongmin24/on-maum:monitoring-service-example
FRONTEND_IMAGE=docker.io/leejeongmin24/on-maum:frontend-example
SIMULATOR_IMAGE=docker.io/leejeongmin24/on-maum:simulator-example

POSTGRES_HOST=10.0.2.20
POSTGRES_USER=nilm_admin
POSTGRES_PASSWORD=replace-with-db-password
EC2_B_PRIVATE_IP=10.0.2.20

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-admin-password
KEYCLOAK_HOSTNAME=https://auth.example.com
JWT_ISSUER_URI=https://auth.example.com/realms/nilm
# true(default): Keycloak JWT required. Set false only for demos/tests; every caller becomes local-user.
APP_SECURITY_ENABLED=true

FRONTEND_ORIGIN=https://nilm.example.com
CORS_ALLOWED_ORIGINS=https://nilm.example.com

NILM_SMOKE_CLIENT_SECRET=replace-with-random-secret
NILM_BACKEND_CLIENT_SECRET=replace-with-random-secret

APP_DOMAIN=nilm.example.com
AUTH_DOMAIN=auth.example.com
# Set by Jenkins: /opt/nilm. For offline validation: this folder.
CONFIG_ROOT=.
OBSERVABILITY_ROOT=../observability

KAFKA_BOOTSTRAP_SERVERS=<EC2_B_PRIVATE_IP>:9092
KAFKA_ANALYSIS_EVENT_TOPIC=analysis.event.v1
KAFKA_MONITORING_DLQ_TOPIC=dlq.monitoring
# iot-device-service가 발행하고 monitoring-service가 구독한다. 양쪽이 같은 값이어야 한다.
KAFKA_MANAGER_REGISTERED_TOPIC=device.manager-registered.v1
# monitoring-service가 외출 구간을 발행한다. ec2-b의 realtime-analysis-service가 구독한다.
KAFKA_OUTING_EVENT_TOPIC=monitoring.household-presence.v1

# 모니터링 서비스
MONITORING_KAFKA_GROUP_ID=monitoring-service-analysis-event-v1

# Gold 생활 프로필. 토픽 생성은 ec2-b(kafka-init)가 하고, 여기서는 구독만 한다.
KAFKA_HOUSEHOLD_PROFILE_TOPIC=gold.household-profile.v1
MONITORING_KAFKA_HOUSEHOLD_PROFILE_GROUP_ID=monitoring-service-household-profile-v1

# 프로필 유효기간(일). 넘으면 버리지 않고 stale로 표시만 한다.
PROFILE_MAX_AGE_DAYS=3
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_ENABLED=true
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Monitoring service: test subject and risk thresholds.
PUSH_TEST_AUTH_SUB=test-subject-3
TEST_DATA_ENABLED=false
TEST_ACCOUNT_PASSWORD=
RISK_WARNING_THRESHOLD=70
RISK_DANGER_THRESHOLD=90

PROMETHEUS_PORT=19090
GRAFANA_PORT=13001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password

# 시연용 시뮬레이터(--profile simulator). 배포 시 자동으로 뜨지 않고 필요할 때만 수동 기동한다.
# 인증서 SAN이 EC2-A 사설 IP이므로 호스트는 localhost나 mosquitto가 아닌 사설 IP여야 한다.
SIMULATOR_MQTT_HOST=10.0.2.10
SIMULATOR_MQTT_USER=simulator_user
SIMULATOR_MQTT_PASS=replace-with-simulator-mqtt-password
SIMULATOR_MQTT_CA_FILE=/opt/nilm/mqtt/certs/ca.crt
SIMULATOR_WEB_PORT=8085
