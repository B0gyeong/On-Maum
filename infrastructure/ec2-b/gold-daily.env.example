# systemd gold-profile-daily.service 전용 비밀값 없는 실행 설정.
# 설치 후 /opt/nilm/gold-daily.env로 복사해 조정한다.
GOLD_DAILY_ATTEMPTS=3
GOLD_DAILY_RETRY_SECONDS=30
# Persistent timer와 함께 최근 날짜를 오래된 순서로 재확인하는 범위.
GOLD_DAILY_CATCHUP_DAYS=3
GOLD_DAILY_TIMEZONE=Asia/Seoul

# Enable after applying reporting_schema.sql and configuring REPORT_DATABASE_URL.
HOUSEHOLD_REPORT_ENABLED=false
HOUSEHOLD_REPORT_WINDOW_DAYS=90
