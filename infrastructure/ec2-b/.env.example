# Syntax-check examples only. Jenkins replaces these with pushed image digests.
MQTT_KAFKA_BRIDGE_IMAGE=docker.io/leejeongmin24/on-maum:mqtt-kafka-bridge-example
REALTIME_ANALYSIS_IMAGE=docker.io/leejeongmin24/on-maum:realtime-analysis-service-example
AGGREGATION_IMAGE=docker.io/leejeongmin24/on-maum:aggregation-service-example
BRONZE_LOADER_IMAGE=docker.io/leejeongmin24/on-maum:bronze-loader-example
SESSION_LAKE_LOADER_IMAGE=docker.io/leejeongmin24/on-maum:session-lake-loader-example
POWER_SILVER_IMAGE=docker.io/leejeongmin24/on-maum:power-silver-example

EC2_B_PRIVATE_IP=10.0.2.20
POSTGRES_USER=nilm_admin
POSTGRES_PASSWORD=replace-with-db-password

KAFKA_RAW_TOPIC=power.raw.v1
KAFKA_ANALYSIS_EVENT_TOPIC=analysis.event.v1
KAFKA_ANALYSIS_ACTIVITY_TOPIC=analysis.activity.v1
KAFKA_ANALYSIS_DATA_QUALITY_TOPIC=analysis.data-quality.v1
KAFKA_ANALYSIS_SNAPSHOT_TOPIC=analysis.snapshot.v1
KAFKA_ANALYSIS_DLQ_TOPIC=dlq.analysis
KAFKA_MONITORING_DLQ_TOPIC=dlq.monitoring
KAFKA_OUTING_EVENT_TOPIC=monitoring.household-presence.v1
# ec2-a의 iot-device-service가 발행한다. kafka-init이 여기서 토픽을 만든다.
KAFKA_MANAGER_REGISTERED_TOPIC=device.manager-registered.v1
# selected_scene 워커의 출력. 상시 분석의 스냅샷 토픽과 반드시 달라야 한다.
KAFKA_SCENE_SNAPSHOT_TOPIC=analysis.scene.v2

# Gold 배치가 만든 가구 생활 프로필. 브로커의 auto-create가 꺼져 있어 미리 만들어 둔다.
KAFKA_HOUSEHOLD_PROFILE_TOPIC=gold.household-profile.v1

# KRaft 클러스터 ID. 한 번 포맷한 볼륨과 값이 달라지면 브로커가 뜨지 않는다.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_PARTITIONS=24
KAFKA_RAW_RETENTION_MS=604800000
KAFKA_RAW_RETENTION_BYTES=2147483648
KAFKA_RAW_SEGMENT_BYTES=268435456
KAFKA_ANALYSIS_RETENTION_MS=604800000
KAFKA_ANALYSIS_RETENTION_BYTES=134217728
KAFKA_ANALYSIS_SEGMENT_BYTES=134217728
KAFKA_DLQ_RETENTION_MS=2592000000
KAFKA_DLQ_RETENTION_BYTES=268435456
KAFKA_DLQ_SEGMENT_BYTES=134217728

ANALYSIS_KAFKA_GROUP_ID=realtime-analysis-service-v1
ANALYSIS_KAFKA_AUTO_OFFSET_RESET=latest
ANALYSIS_KAFKA_PARTITION_ASSIGNMENT_STRATEGY=cooperative-sticky
# 비우면 동적 멤버십. 값을 주면 정적 멤버십이 되고, 인스턴스마다 달라야 한다.
ANALYSIS_KAFKA_GROUP_INSTANCE_ID=
ANALYSIS_KAFKA_OUTING_GROUP_INSTANCE_ID=

# 모델 런타임. 같은 configurable-inference 이미지에서 fake/real/selected_scene을
# 선택한다. real과 selected_scene 가중치는 이미지 안 /assets에 포함되어 있다.
ANALYSIS_MODEL_BACKEND=fake
ANALYSIS_MODEL_ASSET_ROOT=/assets
ANALYSIS_MODEL_WINDOW_SIZE=255
ANALYSIS_MODEL_DEVICE=cpu
ANALYSIS_MODEL_DTYPE=float32
ANALYSIS_MODEL_THREADS=1

# selected_scene 데모 백엔드. 같은 컨테이너에서 선택할 수 있지만 상시 분석과
# 공존할 수 없다. ANALYSIS_MODEL_HOUSEHOLD_ID와 전용 ANALYSIS_RUN_ID /
# KAFKA_RAW_TOPIC / ANALYSIS_KAFKA_GROUP_ID을 함께 설정해야 하며, 하나라도
# 기본값이면 기동 시 검증에서 막힌다.
ANALYSIS_MODEL_APPLIANCE=kettle
ANALYSIS_MODEL_HOUSEHOLD_ID=
# 장면 이벤트 투영. 비활성이면 스냅샷만 내보낸다.
ANALYSIS_SCENE_EVENTS_ENABLED=false
ANALYSIS_SCENE_POLICY_ID=selected-test-v1
# 위험 임계(초)를 주려면 EVENTS_ENABLED=true이고 TEST_HOUSEHOLD_ID가
# ANALYSIS_MODEL_HOUSEHOLD_ID와 같아야 한다. 비워 두면 위험 투영이 꺼진다.
ANALYSIS_SCENE_TEST_HOUSEHOLD_ID=
ANALYSIS_SCENE_RISK_THRESHOLD_SECONDS=

ANALYSIS_FAKE_ON_APPLIANCES=
ANALYSIS_SCORE_THRESHOLD=80
ANALYSIS_TIMEZONE=Asia/Seoul
ANALYSIS_PIPELINE_VERSION=1
ANALYSIS_EXPECTED_SAMPLES_PER_DAY=86400
ANALYSIS_OBSERVATION_VALID_COVERAGE_RATIO=0.95
ROUTINE_BASELINE_REFRESH_SECONDS=60

# 가전 ON/OFF 판정. 연속 몇 샘플이 같은 방향이어야 상태 전환으로 인정할지.
ANALYSIS_APPLIANCE_ON_CONFIRMATION_SAMPLES=3
ANALYSIS_APPLIANCE_OFF_CONFIRMATION_SAMPLES=3
ANALYSIS_APPLIANCE_OFF_THRESHOLD_MARGIN=0.05

# 수집 끊김 판정과 복구 확인.
ANALYSIS_DATA_GAP_THRESHOLD_SECONDS=120
ANALYSIS_DATA_QUALITY_POLL_SECONDS=5
ANALYSIS_DATA_RECOVERY_CONFIRMATION_SAMPLES=3
ANALYSIS_LOG_LEVEL=INFO

# 집계 서비스: 활동 지표 일배치 발행 시각(ANALYSIS_TIMEZONE 기준)과 스케줄러 폴링 주기.
ACTIVITY_INDEX_PUBLISH_HOUR=0
ACTIVITY_INDEX_PUBLISH_MINUTE=10
ACTIVITY_INDEX_SCHEDULER_POLL_SECONDS=30

# 루틴 베이스라인 산출 조건. Gold 배치의 GOLD_PROFILE_* 값과 맞춰 둔다.
ROUTINE_BASELINE_WINDOW_DAYS=28
ROUTINE_BASELINE_MINIMUM_SAMPLE_DAYS=14
ROUTINE_BASELINE_MINIMUM_WEEKDAY_SAMPLE_DAYS=4
ROUTINE_BASELINE_MINIMUM_DAILY_USE_PROBABILITY=0.70
ANALYSIS_MAXIMUM_GAP_SECONDS=120
AGGREGATION_LOG_LEVEL=INFO

# Bronze loader: power.raw.v1 -> HDFS Bronze (Parquet).
BRONZE_KAFKA_GROUP_ID=hdfs-bronze-loader
BRONZE_BASE=/nilm/bronze/power
BRONZE_QUARANTINE_BASE=/nilm/quarantine/power
BRONZE_MANIFEST_BASE=/nilm/manifests/job=bronze-loader

# Flush on whichever comes first.
BRONZE_FLUSH_SECS=300
BRONZE_MAX_BUFFER=50000

# Session lake loader: appliance_usage_session outbox -> HDFS Bronze (Parquet).
# Session Bronze is not subject to the power Bronze retention below.
SESSION_BRONZE_BASE=/nilm/bronze/appliance-session
SESSION_MANIFEST_BASE=/nilm/manifests/job=session-lake-loader
RECEIPT_BRONZE_BASE=/nilm/bronze/analysis-processing-receipt
RECEIPT_MANIFEST_BASE=/nilm/manifests/job=analysis-receipt-lake-loader
SESSION_LAKE_POLL_SECONDS=60
SESSION_LAKE_BATCH_MAX_EVENTS=5000
SESSION_LAKE_MAX_BATCHES_PER_CYCLE=20
SESSION_LAKE_ROWS_PER_FILE=200000
SESSION_LAKE_RETRY_BACKOFF_SECONDS=30
SESSION_LAKE_RETRY_MAX_BACKOFF_SECONDS=900
# 0 = retry forever; batches beyond the limit stay FAILED and show as STALLED in `status`.
SESSION_LAKE_MAX_ATTEMPTS=0
SESSION_LAKE_LOG_LEVEL=INFO

# power-silver-daily: Bronze power -> Silver clean power and household observation days.
# Run once a day (docker compose run --rm power-silver power-silver run), not a daemon.
POWER_SILVER_LAKE_FS_URI=hdfs://namenode:9000
SILVER_BASE=/nilm/silver
POWER_SILVER_QUARANTINE_BASE=/nilm/quarantine/power_silver
POWER_SILVER_MANIFEST_BASE=/nilm/manifests/job=power-silver-daily
ANALYSIS_MANIFEST_BASE=/nilm/manifests/job=analysis-usage-daily
GOLD_BASE=/nilm/gold
BUSINESS_UTC_OFFSET_SECONDS=32400
POWER_SILVER_RULE_VERSION=power-silver-v1
POWER_SILVER_INPUT_READY_GRACE_SECONDS=1800
POWER_SILVER_INPUT_WAIT_DEADLINE_SECONDS=21600
POWER_SILVER_FUTURE_SKEW_SECONDS=300
POWER_SILVER_MANIFEST_SCAN_BACK_DAYS=1
ANALYSIS_RUN_ID=realtime-v1
ANALYSIS_DAILY_RULE_VERSION=analysis-coverage-v1
ANALYSIS_QUALITY_POLICY_VERSION=baseline-quality-v1
ANALYSIS_DAILY_MAXIMUM_GAP_SECONDS=120
# Empty = Spark local mode inside the container. Point at spark://host:7077 to submit.
POWER_SILVER_SPARK_MASTER=
POWER_SILVER_SPARK_SHUFFLE_PARTITIONS=0
POWER_SILVER_LOG_LEVEL=INFO
GOLD_PROFILE_IMAGE=ghcr.io/example/nilm-gold-profile:latest
GOLD_PROFILE_MANIFEST_BASE=/nilm/manifests/job=gold-profile
GOLD_PROFILE_STAGING_BASE=/nilm/gold/.staging/job=gold-profile
GOLD_PROFILE_WINDOW_DAYS=28
GOLD_PROFILE_MINIMUM_SAMPLE_DAYS=14
GOLD_PROFILE_MINIMUM_WEEKDAY_SAMPLE_DAYS=4
GOLD_PROFILE_MINIMUM_DAILY_USE_PROBABILITY=0.70
GOLD_PROFILE_TIME_BUCKET_MINUTES=30
GOLD_PROFILE_RULE_VERSION=gold-profile-v1
GOLD_PROFILE_STATISTIC_RULE_VERSION=household-statistics-v1-nearest-rank
# Profile delivery. SHADOW only fills the outbox; the monitoring service keeps
# using its current profile. Raise to ACTIVE once the pipeline is verified
# end to end.
GOLD_PROFILE_DELIVERY_MODE=SHADOW
GOLD_PROFILE_PUBLISHER_BATCH_SIZE=100
GOLD_PROFILE_PUBLISHER_RETRY_SECONDS=30
GOLD_PROFILE_LOG_LEVEL=INFO

# HDFS retention is planned by the aggregation service. Apply remains off until
# dry-run output has been reviewed in production.
RETENTION_MANIFEST_BASE=/nilm/manifests/job=retention
RETENTION_ENABLED=true
RETENTION_APPLY=false
RETENTION_REQUIRE_COMPACTION=true
BRONZE_RETENTION_DAYS=14
BRONZE_GRACE_DAYS=3
RETENTION_MAX_DELETE_BYTES=5368709120
RETENTION_MAX_DELETE_DATES=1

# EC2-B 309 GiB root disk budget: HDFS total 80 GiB, Bronze 32 GiB.
HDFS_QUOTA_ENABLED=true
HDFS_TOTAL_QUOTA=80g
HDFS_BRONZE_QUOTA=32g
HDFS_QUARANTINE_QUOTA=8g
HDFS_SESSION_BRONZE_QUOTA=4g
HDFS_MANIFEST_QUOTA=2g
HDFS_SILVER_QUOTA=24g
HDFS_GOLD_QUOTA=2g

# DNS name must match the Mosquitto server certificate's SAN.
MQTT_HOST=mqtt.internal.example.com
MQTT_PORT=8883
MQTT_USER=kafka_bridge_user
MQTT_PASS=replace-with-bridge-password
MQTT_CA_FILE=/etc/mqtt/ca.crt
CONFIG_ROOT=.
